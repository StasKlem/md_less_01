# ===========================================
# KBJU Bot Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните значениями

# -------------------------------------------
# Telegram Bot Settings
# -------------------------------------------
# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Таймаут запросов к Telegram API
TELEGRAM_TIMEOUT=30s

# -------------------------------------------
# LLM Provider Settings
# -------------------------------------------
# Провайдер: openai, anthropic, или другой совместимый
LLM_PROVIDER=openai

# API ключ для доступа к LLM (обязательно)
# Для routerai.ru используйте ваш ключ от https://routerai.ru
LLM_API_KEY=your_llm_api_key_here

# Модель для запросов
# Для routerai.ru: deepseek/deepseek-v3.2, deepseek/deepseek-chat и другие
LLM_MODEL=deepseek/deepseek-v3.2

# Базовый URL API
# Для routerai.ru оставьте как указано ниже
LLM_BASE_URL=https://routerai.ru/api/v1

# Таймаут запросов к LLM API
LLM_TIMEOUT=60s

# -------------------------------------------
# Database Settings
# -------------------------------------------
# Путь к файлу SQLite базы данных
# В Docker контейнере: /app/data/kbju.db
DATABASE_PATH=./data/kbju.db

# Максимальное количество открытых соединений (для SQLite рекомендуется 1)
DATABASE_MAX_OPEN_CONNS=1

# Максимальное количество простых соединений
DATABASE_MAX_IDLE_CONNS=1

# Время жизни соединения
DATABASE_CONN_MAX_LIFETIME=5m

# -------------------------------------------
# Access Control Settings
# -------------------------------------------
# Режим доступа: whitelist или public
# - whitelist: доступ только пользователям из ALLOWED_USER_IDS
# - public: доступ разрешен всем
ACCESS_CONTROL_MODE=public

# Список ID пользователей через запятую (для режима whitelist)
# Получить ID можно через бота @userinfobot или аналогичные
# Пример: ACCESS_CONTROL_ALLOWED_USER_IDS=123456789,987654321
ACCESS_CONTROL_ALLOWED_USER_IDS=

# -------------------------------------------
# Report Settings
# -------------------------------------------
# Время отправки ежедневного отчета (формат HH:MM)
REPORT_SEND_TIME=21:00

# Часовой пояс для отправки отчетов
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
REPORT_TIMEZONE=Europe/Moscow

# -------------------------------------------
# Logging Settings
# -------------------------------------------
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# Формат логов: text, json
LOG_FORMAT=text

# -------------------------------------------
# Application Settings
# -------------------------------------------
# Версия приложения (устанавливается автоматически при сборке)
APP_VERSION=dev

# Часовой пояс приложения
TZ=Europe/Moscow
